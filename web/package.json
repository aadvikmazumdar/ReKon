{
  "name": "rekon-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "export": "cd .. && python3 -m rekon.export_web",
    "check": "esbuild scripts/render-check.tsx --bundle --platform=node --format=cjs --outfile=node_modules/.cache/render-check.cjs --log-level=error && node node_modules/.cache/render-check.cjs",
    "verify": "npm run build && npm run check"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "esbuild": "^0.23.0"
  }
}